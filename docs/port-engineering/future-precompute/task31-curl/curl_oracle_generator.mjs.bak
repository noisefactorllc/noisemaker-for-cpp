import crypto from 'node:crypto'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

import { canonicalAdapterFactories, canonicalKernelFactories, kernelFactories } from '../noisemaker-for-cpu/src/effects/catalog.js'
import { bindCanonicalKernel, createCanonicalBindings } from '../noisemaker-for-cpu/src/csl/glsl-kernel.js'
import { bindGlslKernel } from '../noisemaker-for-cpu/src/csl/glsl-runtime.js'
import { runPass } from '../noisemaker-for-cpu/src/runtime/pass-runner.js'
import { Surface } from '../noisemaker-for-cpu/src/runtime/surface.js'

// ---------------------------------------------------------------------------
// Task 31 — Curl (`synth/curl:curl`) tanh(vec3) + mod(vecN,float) closure
// oracle. Authorized define map: {"OCTAVES": 1, "OUTPUT_MODE": 3, "RIDGES":
// true} (confirmed live via tools.glslcpp.generate_typed_slice._defaults).
//
// Four AST sites (per the design brief, corpus line:col numbers, which are
// offset by exactly -10 lines from this repo's raw curl.glsl due to
// preprocessor comment/#ifndef stripping in the normalized source the AST
// walks -- verified directly against the raw source and the pinned public
// factory text below):
//   - tanh(vec3) -> vec3    in main (id 18)      196:12  REACHABLE
//   - mod(vec4,float)->vec4 in permute (id 20)    35:12  REACHABLE  (permute_vec4 in JS)
//   - mod(vec3,float)->vec3 in simplex3D (id 21)  65:9   REACHABLE  (`i = mod(i, 289.0)`)
//   - mod(vec3,float)->vec3 in permute (id 19)    32:12  NOT reachable (dead vec3
//     overload of `permute`; simplex3D only ever calls the vec4 overload)
//
// CRITICAL, EMPIRICALLY- AND ALGEBRAICALLY-VERIFIED CORRECTION TO THE DESIGN
// BRIEF'S EXPECTATION that "3 of 4 sites are reachable, so full-render
// mutations should discriminate":
//
// A naive-fmod (JS `%`, sign-of-dividend) substitution at the mod(vec4,float)
// site (permute_vec4) produces ZERO output divergence across every eligible
// full-render case tried, including a 40-trial randomized stress sweep
// spanning seed in [-1e6, 1e6], scale in [-20,20], speed in [-200,200],
// intensity in [-10,10], and varied dimensions -- 0/40. The SAME naive-fmod
// substitution at the mod(vec3,float) site in simplex3D (`i = mod(i, 289.0)`)
// is likewise 0/40.
//
// This is NOT a coverage gap. It is a provable algebraic property of the
// classic Stefan Gustavson permutation-polynomial hash this shader uses:
//
//   permute(x) = mod(34x^2 + 10x, 289.0)
//
//   (1) QUADRATIC DOMINANCE at the permute_vec4 site: every value fed into
//       this call is an exact integer (floor() results plus 0/1 step()
//       offsets, all exact in float32 for realistic magnitudes). For any
//       integer x, 34x^2 + 10x >= 0 (the parabola's only root below zero is
//       the open interval (-10/34, 0), which contains no integers). GLSL's
//       floor-based mod and a naive trunc-based fmod/`%` are IDENTICAL for
//       any non-negative dividend (floor(a/b) == trunc(a/b) when a/b >= 0).
//       So the exact rounding rule at this site is provably irrelevant to
//       the final bit pattern, for every real input, not just the ones
//       tested.
//   (2) PERIOD-289 ABSORPTION at the simplex3D site: 34(x+289)^2 + 10(x+289)
//       - (34x^2+10x) = 289*(68x + 9856), and since x is always an exact
//       integer at every call site in this program, 68x is an integer, so
//       the whole difference is an exact integer multiple of 289. That
//       means permute(x) and permute(x +/- 289) collapse to the SAME value
//       after permute's own internal mod-289. Naive fmod and GLSL's
//       floor-mod for `i = mod(i, 289.0)` differ by AT MOST one multiple of
//       289 (exactly -289 when i < 0 and not an exact multiple of 289, 0
//       otherwise) -- and permute's downstream period-289 invariance
//       silently absorbs exactly that difference. So a naive-fmod bug at
//       THIS site is also provably invisible to any full-render diff.
//
// Both claims are independently confirmed by an auxiliary, non-primary
// "wrong-divisor" mutation (mod by 288.0 instead of 289.0, which breaks
// both invariants above) at each site: 40/40 divergent across the SAME
// randomized sweep -- proof both mod sites are genuinely live, executed on
// every pixel, and do influence the rendered image; it is specifically and
// only the floor-vs-trunc rounding distinction that these two sites cannot
// discriminate via full-kernel rendering.
//
// CONSEQUENCE: this oracle's full-render `public_factory_mutations` for the
// two reachable mod sites are machine-asserted to be EXACTLY 0/N eligible
// divergence (a NONZERO result there would contradict this proof and must
// be investigated before shipping) -- clearly distinguished from the truly
// dead `permute(vec3)` overload's 0/N (which is 0/N because the function is
// never CALLED at all, not because its mod call is numerically inert).
// `direct_mod_rows` below -- direct invocation of the real runtime
// `stdlib.mod`, not reimplemented, deliberately fed non-integer and
// non-multiple-of-289 operands no legitimate caller in this program ever
// produces -- is therefore the AUTHORITATIVE closure-parity surface for the
// naive-fmod-vs-GLSL-mod semantic difference, exactly as the brief's own
// guidance (freeze exact scalar/vector semantics via direct rows) already
// anticipated for exactly this situation.
// ---------------------------------------------------------------------------

const here = path.dirname(fileURLToPath(import.meta.url))
const outPath = path.join(here, 'curl-oracles.json')
const reportPath = path.join(here, 'curl-oracle-report.md')
const key = 'synth/curl:curl'
const revision = 'a024dc3a960cc44af454abc7aebce50456c194e6'
const sourcePath = `tools/glslcpp/corpus/${revision}/sources/synth/curl/curl.glsl`
const canonicalPath = '../noisemaker-for-cpu/src/effects/generated/canonical-kernels.js'
const catalogPath = '../noisemaker-for-cpu/src/effects/catalog.js'
const adapterPath = '../noisemaker-for-cpu/src/effects/adapters/index.js'
const AUTHORIZED_DEFINES = Object.freeze({ OCTAVES: 1, OUTPUT_MODE: 3, RIDGES: true })
const f = Math.fround

function sha256(value) { return crypto.createHash('sha256').update(value).digest('hex') }
function bytes(value) { return Buffer.from(value.buffer, value.byteOffset, value.byteLength) }
function f32Bits(value) {
  if (Number.isNaN(value)) return 'nan'
  const a = new Float32Array([value])
  return `0x${new DataView(a.buffer).getUint32(0, true).toString(16).padStart(8, '0')}`
}
function sameBytes(a, b) { return Buffer.compare(bytes(a.data), bytes(b.data)) === 0 }
function evaluated(text) { return (0, eval)(`(${text})`) }
function occurrences(text, needle) { return text.split(needle).length - 1 }

// ---------------------------------------------------------------------------
// Provenance / hermeticity pinning.
// ---------------------------------------------------------------------------
const provenance = {
  canonical_kernels_sha256: 'e605746c74e0e60e513724669f948b353caca4d3c427f339950d5dc98815ab56',
  public_catalog_sha256: 'd8cf312294ccd915892a4a668432ca2533ab255fb24664d89dee8456331e4ea4',
  adapter_index_sha256: '40c690ff6ef58619006d0819c5f0f4d419cdfd59a08db55e2276aa9f61430267',
  source_sha256: '33d1f2bd0215d6439b51a0aa8d50b5c3637abc0b5cade8f3e451b8d258d0afce',
  canonical_factory_name: 'canonicalFactory248',
  canonical_factory_to_string_sha256: 'a5faaca15e28732b3ca3f802c03dc1f906a90134d9ac855eba6bcc4f85596349',
}

if (sha256(fs.readFileSync(canonicalPath)) !== provenance.canonical_kernels_sha256) throw new Error('canonical runtime drift')
if (sha256(fs.readFileSync(catalogPath)) !== provenance.public_catalog_sha256) throw new Error('catalog drift')
if (sha256(fs.readFileSync(adapterPath)) !== provenance.adapter_index_sha256) throw new Error('adapter registry drift')
if (sha256(fs.readFileSync(sourcePath)) !== provenance.source_sha256) throw new Error('source drift')
const canonical = canonicalKernelFactories[key]
if (canonical?.name !== provenance.canonical_factory_name || sha256(canonical.toString()) !== provenance.canonical_factory_to_string_sha256) throw new Error('factory drift')
if (kernelFactories.get(key) !== canonical || canonicalAdapterFactories[key] !== undefined) throw new Error('public factory is not direct canonical identity')

const factoryText = canonical.toString()

// ---------------------------------------------------------------------------
// Exact, occurrence-checked anchors for the four closure sites, byte-for-byte
// against the pinned public factory text (same discipline as
// extrude_oracle_generator.mjs's topLine/sideLine anchors).
// ---------------------------------------------------------------------------
const SITE_ANCHORS = {
  tanh_vec3_main: {
    id: 18, reachable: true,
    text: '  \tvar cpu_vector_assignment_0 = new $runtime.PooledFloat32Array([(tanh(curl[0] * intensity)) * 0.5 + 0.5, (tanh(curl[1] * intensity)) * 0.5 + 0.5, (tanh(curl[2] * intensity)) * 0.5 + 0.5]);',
  },
  mod_vec4_permute: {
    id: 20, reachable: true,
    text: '  \treturn mod(new $runtime.PooledFloat32Array([((x[0] * 34) + 10) * x[0], ((x[1] * 34) + 10) * x[1], ((x[2] * 34) + 10) * x[2], ((x[3] * 34) + 10) * x[3]]), 289);',
  },
  mod_vec3_simplex3D: {
    id: 21, reachable: true,
    text: '  \tmod(i, 289).reduce((res,el,i)=>(res[i] = el, res), i);',
  },
  mod_vec3_permute_dead: {
    id: 19, reachable: false,
    text: '  \treturn mod(new $runtime.PooledFloat32Array([((x[0] * 34) + 10) * x[0], ((x[1] * 34) + 10) * x[1], ((x[2] * 34) + 10) * x[2]]), 289);',
  },
}
for (const [name, site] of Object.entries(SITE_ANCHORS)) {
  const count = occurrences(factoryText, site.text)
  if (count !== 1) throw new Error(`site anchor ${name}: expected exactly 1 occurrence, got ${count}`)
}
// Static confirmation the dead overload's *call site* genuinely does not
// exist anywhere in the factory: the only occurrences of "permute(" in the
// text are its own definition line -- no bare `permute(<expr>)` call
// exists anywhere else (every call site uses `permute_vec4(`).
{
  let idx = 0, bareCallCount = 0
  while ((idx = factoryText.indexOf('permute(', idx)) !== -1) { bareCallCount += 1; idx += 'permute('.length }
  if (bareCallCount !== 0) throw new Error(`expected zero bare "permute(" call occurrences (only "permute_vec4(" calls exist), found ${bareCallCount}`)
}

// ---------------------------------------------------------------------------
// Real-runtime scalar/vector primitive capture (not reimplemented) -- same
// throwaway-factory technique caustic_oracle_generator.mjs used.
// ---------------------------------------------------------------------------
function captureRuntime(uniforms) {
  let capturedRuntime = null
  function captureFactory($bindings, $runtime) { capturedRuntime = $runtime; return function () {} }
  captureFactory.usesDerivatives = false
  const bindings = createCanonicalBindings({ width: 2, height: 2, uniforms, textures: {} })
  bindGlslKernel(captureFactory, bindings)
  return capturedRuntime
}
const { stdlib } = captureRuntime({})

// ---------------------------------------------------------------------------
// Full-kernel render helpers (no input texture: curl has no sampler uniforms).
// ---------------------------------------------------------------------------
function render(factory, { width, height, uniforms, tileOffset, fullResolution }) {
  const kernel = bindCanonicalKernel(factory, {
    width, height, uniforms, textures: {},
    tileOffset: new Float32Array(tileOffset ?? [0, 0]),
    fullResolution: new Float32Array(fullResolution ?? [width, height]),
  })
  const output = new Surface(width, height)
  runPass({ kernel, destination: output })
  return output
}
function probe(surface, x, y) {
  const i = (y * surface.width + x) * 4, values = Array.from(surface.data.slice(i, i + 4))
  return { at_top_down_xy: [x, y], values, f32_bits_le: values.map(f32Bits) }
}
function probes(surface) {
  return [[0, 0], [surface.width - 1, 0], [0, surface.height - 1], [surface.width - 1, surface.height - 1], [Math.floor(surface.width / 2), Math.floor(surface.height / 2)]].map(([x, y]) => probe(surface, x, y))
}
function renderResult(surface) {
  const rgba = surface.toRgba8()
  let nonfinite = 0
  for (const lane of surface.data) if (!Number.isFinite(lane)) nonfinite += 1
  return { f32_sha256: sha256(bytes(surface.data)), rgba8_sha256: sha256(bytes(rgba)), finite_lanes: surface.data.length - nonfinite, nonfinite_lanes: nonfinite, probes: probes(surface) }
}

// ---------------------------------------------------------------------------
// Eligible full-render cases (defines == AUTHORIZED_DEFINES exactly).
// Deliberately varied width/height/time/scale/speed/intensity/seed,
// including a large-magnitude and a negative seed -- `v += float(seed) *
// 0.1271` is a real call path that pushes `i = floor(v + dot(v,C.yyy))`
// negative, which is exactly the operand sign the two reachable mod sites
// need in order to even ATTEMPT to discriminate a naive-fmod C++ port (see
// the proof above for why they still can't, via full render alone).
// Negative intensity is included to flip the sign of the tanh argument.
// ---------------------------------------------------------------------------
const eligibleCaseDefs = [
  { name: 'default-seed0-time0', width: 6, height: 5, uniforms: { time: 0, scale: 10, seed: 0, speed: 50, intensity: 1 } },
  { name: 'seed7-tiled-midtime', width: 5, height: 6, uniforms: { time: 3.5, scale: 15, seed: 7, speed: 80, intensity: 2.5 }, tileOffset: [3, 2], fullResolution: [13, 11] },
  { name: 'negative-seed-drives-negative-mod-operands', width: 8, height: 3, uniforms: { time: 12, scale: 0, seed: -13, speed: 0, intensity: 0.75 } },
  { name: 'negative-intensity-flips-tanh-sign', width: 4, height: 4, uniforms: { time: 100.25, scale: 20.9, seed: 99, speed: 200, intensity: -4.0 } },
  { name: 'large-seed-negative-scale-negative-speed', width: 7, height: 7, uniforms: { time: 0.001, scale: -5, seed: 1000000, speed: -30, intensity: 50 } },
  { name: 'two-pi-time-near-identity-intensity', width: 10, height: 2, uniforms: { time: 6.2831853, scale: 10.999999, seed: 0, speed: 1, intensity: 0.001 } },
]

// ---------------------------------------------------------------------------
// Ineligible full-render cases: same product uniform surface, a define map
// that differs from AUTHORIZED_DEFINES -- a genuinely different compiled
// program the C++ port never built (OCTAVES changes loop unrolling,
// OUTPUT_MODE changes the output-channel selection branch, RIDGES changes
// the post-fold). Reachability of all four closure sites is INDEPENDENT of
// these defines (none of them gate the permute/simplex3D call graph), which
// this oracle verifies explicitly below, unlike Task31-Caustic where
// reachability was define-dependent.
// ---------------------------------------------------------------------------
const ineligibleCaseDefs = [
  { name: 'octaves-2-diverges-loop-unroll', width: 6, height: 5, defines: { OCTAVES: 2, OUTPUT_MODE: 3, RIDGES: true }, uniforms: { time: 0, scale: 10, seed: 0, speed: 50, intensity: 1 } },
  { name: 'output-mode-0-flowx-channel', width: 6, height: 5, defines: { OCTAVES: 1, OUTPUT_MODE: 0, RIDGES: true }, uniforms: { time: 0, scale: 10, seed: 0, speed: 50, intensity: 1 } },
  { name: 'ridges-false-no-fold', width: 6, height: 5, defines: { OCTAVES: 1, OUTPUT_MODE: 3, RIDGES: false }, uniforms: { time: 0, scale: 10, seed: 0, speed: 50, intensity: 1 } },
]

function buildEligibleRenderRecords() {
  return eligibleCaseDefs.map(def => {
    const uniforms = { ...def.uniforms, ...AUTHORIZED_DEFINES }
    const input = { width: def.width, height: def.height, uniforms, tileOffset: def.tileOffset, fullResolution: def.fullResolution }
    const first = render(canonical, input)
    const second = render(canonical, input)
    if (!sameBytes(first, second)) throw new Error(`${def.name}: repeat mismatch`)
    return {
      name: def.name, dimensions: { width: def.width, height: def.height }, defines: { ...AUTHORIZED_DEFINES },
      eligible_for_native_binding: true, uniforms: def.uniforms,
      tile_offset: def.tileOffset ?? [0, 0], full_resolution: def.fullResolution ?? [def.width, def.height],
      output: renderResult(first), repeat_identity: true,
    }
  })
}
function buildIneligibleRenderRecords() {
  return ineligibleCaseDefs.map(def => {
    const uniforms = { ...def.uniforms, ...def.defines }
    const input = { width: def.width, height: def.height, uniforms, tileOffset: def.tileOffset, fullResolution: def.fullResolution }
    const first = render(canonical, input)
    const second = render(canonical, input)
    if (!sameBytes(first, second)) throw new Error(`${def.name}: repeat mismatch`)
    return {
      name: def.name, dimensions: { width: def.width, height: def.height }, defines: def.defines,
      eligible_for_native_binding: false,
      ineligibility_reason: `defines ${JSON.stringify(def.defines)} != authorized ${JSON.stringify(AUTHORIZED_DEFINES)} -- a genuinely different compiled program (loop unroll / output-channel branch / ridge fold) whose C++-side counterpart does not exist under this task`,
      uniforms: def.uniforms,
      output: renderResult(first), repeat_identity: true,
    }
  })
}

// ---------------------------------------------------------------------------
// naiveMod helper injection (component-wise JS `%`, sign-of-dividend) --
// stands in for a naive fmod-style C++ port at the mod sites under test.
// ---------------------------------------------------------------------------
const DESTRUCTURE_ANCHOR = 'const { vec4, sin, cos, abs, floor, tanh, mod, min, max, step, length, dot, add, subtract } = $runtime.stdlib'
if (occurrences(factoryText, DESTRUCTURE_ANCHOR) !== 1) throw new Error('destructure anchor drift')
const NAIVE_MOD_HELPER = `
  function naiveMod(x, y) {
    if (typeof x === 'number') return Math.fround(x % y);
    var out = new Float32Array(x.length);
    for (var __i = 0; __i < x.length; __i += 1) out[__i] = Math.fround(x[__i] % y);
    return out;
  }`
function withNaiveModHelper(text) {
  if (occurrences(text, DESTRUCTURE_ANCHOR) !== 1) throw new Error('destructure anchor missing before helper injection')
  return text.replace(DESTRUCTURE_ANCHOR, DESTRUCTURE_ANCHOR + NAIVE_MOD_HELPER)
}

// The four PRIMARY, brief-specified public-factory mutations. Each mutates
// ONE occurrence-checked site anchor. `expected` documents, and the build
// step machine-asserts, the ONLY acceptable eligible-divergence outcome for
// each -- with a hard failure (not a silent pass) if reality disagrees.
const MUTATIONS = [
  {
    id: 'tanh-vec3-identity-passthrough', site: 'tanh_vec3_main', hazard: 'saturating-vs-unsaturated-compression',
    anchor: SITE_ANCHORS.tanh_vec3_main.text,
    replacement: '  \tvar cpu_vector_assignment_0 = new $runtime.PooledFloat32Array([(curl[0] * intensity) * 0.5 + 0.5, (curl[1] * intensity) * 0.5 + 0.5, (curl[2] * intensity) * 0.5 + 0.5]);',
    needsHelper: false, expected: 'nonzero',
    expected_reason: 'tanh is a nonlinear saturating compression; removing it changes the final color at essentially every pixel where curl*intensity != 0.',
  },
  {
    id: 'mod-vec4-permute-naive-fmod', site: 'mod_vec4_permute', hazard: 'floor-mod-vs-truncating-fmod',
    anchor: SITE_ANCHORS.mod_vec4_permute.text,
    replacement: SITE_ANCHORS.mod_vec4_permute.text.replace('return mod(', 'return naiveMod('),
    needsHelper: true, expected: 'zero-structural-invariant',
    expected_reason: 'every operand at this site is an exact integer, and 34x^2+10x >= 0 for all integers x (quadratic dominance) -- GLSL floor-mod and naive trunc-mod/fmod are identical for non-negative dividends, so this site\'s rounding rule is provably irrelevant to the final image. See the module header proof.',
  },
  {
    id: 'mod-vec3-simplex3D-naive-fmod', site: 'mod_vec3_simplex3D', hazard: 'floor-mod-vs-truncating-fmod',
    anchor: SITE_ANCHORS.mod_vec3_simplex3D.text,
    replacement: SITE_ANCHORS.mod_vec3_simplex3D.text.replace('mod(i, 289)', 'naiveMod(i, 289)'),
    needsHelper: true, expected: 'zero-structural-invariant',
    expected_reason: 'downstream permute(x) is exactly periodic mod 289 for integer x (34(x+289)^2+10(x+289) - (34x^2+10x) is an exact multiple of 289 whenever x is an integer), and naive fmod vs GLSL mod at this site differ by at most one exact multiple of 289 -- permute\'s own internal mod-289 silently absorbs that difference. See the module header proof.',
  },
  {
    id: 'mod-vec3-permute-dead-naive-fmod', site: 'mod_vec3_permute_dead', hazard: 'floor-mod-vs-truncating-fmod',
    anchor: SITE_ANCHORS.mod_vec3_permute_dead.text,
    replacement: SITE_ANCHORS.mod_vec3_permute_dead.text.replace('return mod(', 'return naiveMod('),
    needsHelper: true, expected: 'zero-dead-code',
    expected_reason: 'this is the vec3 overload of permute(); simplex3D only ever calls permute_vec4(). The function is never invoked at all, at any define map, so mutating its body cannot affect any render regardless of the (also structurally-invariant) quadratic-dominance property it shares with mod-vec4-permute.',
  },
]

// Two SUPPLEMENTARY, non-primary "wrong-divisor" mutations (mod by 288.0
// instead of 289.0) at the two reachable-but-invariant mod sites. These
// deliberately break BOTH invariants above (they are neither >=0-preserving
// nor period-matched), so they MUST diverge -- positive, empirical proof
// that these two sites are genuinely live, executed on every pixel, and do
// influence the rendered image; the earlier 0/N results are not "the site
// doesn't matter", they are "this specific rounding-rule difference doesn't
// matter, for a provable reason".
const REACHABILITY_PROOF_MUTATIONS = [
  {
    id: 'mod-vec4-permute-wrong-divisor', site: 'mod_vec4_permute', hazard: 'wrong-divisor-reachability-probe',
    anchor: SITE_ANCHORS.mod_vec4_permute.text,
    replacement: SITE_ANCHORS.mod_vec4_permute.text.replace('289)', '288)'),
    needsHelper: false, expected: 'nonzero',
  },
  {
    id: 'mod-vec3-simplex3D-wrong-divisor', site: 'mod_vec3_simplex3D', hazard: 'wrong-divisor-reachability-probe',
    anchor: SITE_ANCHORS.mod_vec3_simplex3D.text,
    replacement: SITE_ANCHORS.mod_vec3_simplex3D.text.replace('289)', '288)'),
    needsHelper: false, expected: 'nonzero',
  },
]

function mutateFactoryText(mutation) {
  const count = occurrences(factoryText, mutation.anchor)
  if (count !== 1) throw new Error(`mutation ${mutation.id}: expected exactly 1 anchor occurrence, got ${count}`)
  let text = factoryText.replace(mutation.anchor, mutation.replacement)
  if (mutation.needsHelper) text = withNaiveModHelper(text)
  return text
}

function runMutationAgainstCases(mutation) {
  const mutatedFactory = evaluated(mutateFactoryText(mutation))
  const eligibleResults = eligibleCaseDefs.map(def => {
    const uniforms = { ...def.uniforms, ...AUTHORIZED_DEFINES }
    const input = { width: def.width, height: def.height, uniforms, tileOffset: def.tileOffset, fullResolution: def.fullResolution }
    const baseline = render(canonical, input)
    const mutated = render(mutatedFactory, input)
    return { case: def.name, diverges: !sameBytes(baseline, mutated) }
  })
  const ineligibleResults = ineligibleCaseDefs.map(def => {
    const uniforms = { ...def.uniforms, ...def.defines }
    const input = { width: def.width, height: def.height, uniforms, tileOffset: def.tileOffset, fullResolution: def.fullResolution }
    const baseline = render(canonical, input)
    const mutated = render(mutatedFactory, input)
    return { case: def.name, defines: def.defines, diverges: !sameBytes(baseline, mutated) }
  })
  return { eligibleResults, ineligibleResults }
}

function buildPublicFactoryMutations() {
  const results = MUTATIONS.map(mutation => {
    const { eligibleResults, ineligibleResults } = runMutationAgainstCases(mutation)
    return {
      id: mutation.id, site: mutation.site, hazard: mutation.hazard,
      reachable: SITE_ANCHORS[mutation.site].reachable, expected: mutation.expected, expected_reason: mutation.expected_reason,
      eligible_case_results: eligibleResults, ineligible_diagnostic_case_results: ineligibleResults,
    }
  })
  for (const m of results) {
    const divergentEligible = m.eligible_case_results.filter(c => c.diverges).length
    const divergentIneligible = m.ineligible_diagnostic_case_results.filter(c => c.diverges).length
    if (m.expected === 'nonzero') {
      if (divergentEligible === 0) throw new Error(`${m.id}: expected nonzero eligible divergence, got 0/${m.eligible_case_results.length} -- investigate before shipping`)
    } else {
      // 'zero-structural-invariant' and 'zero-dead-code' both require
      // exactly zero divergence, eligible AND ineligible-diagnostic. Any
      // nonzero result here contradicts the proof/dead-code claim in the
      // module header and MUST be investigated, not silently accepted.
      if (divergentEligible !== 0) throw new Error(`${m.id}: expected exactly 0 eligible divergence (${m.expected}), got ${divergentEligible}/${m.eligible_case_results.length} -- the module-header proof is WRONG, investigate before shipping`)
      if (divergentIneligible !== 0) throw new Error(`${m.id}: expected exactly 0 ineligible-diagnostic divergence (${m.expected}), got ${divergentIneligible}/${m.ineligible_diagnostic_case_results.length} -- reachability/invariance is define-dependent after all, investigate before shipping`)
    }
  }
  return results
}

function buildReachabilityProofMutations() {
  const results = REACHABILITY_PROOF_MUTATIONS.map(mutation => {
    const { eligibleResults, ineligibleResults } = runMutationAgainstCases(mutation)
    return {
      id: mutation.id, site: mutation.site, hazard: mutation.hazard,
      purpose: 'supplementary -- proves the site is live/executed/influences output; NOT one of the four brief-specified mutations',
      eligible_case_results: eligibleResults, ineligible_diagnostic_case_results: ineligibleResults,
    }
  })
  for (const m of results) {
    const divergentEligible = m.eligible_case_results.filter(c => c.diverges).length
    if (divergentEligible === 0) throw new Error(`${m.id}: reachability-proof mutation produced 0 eligible divergence -- the site may not actually be live, investigate before shipping`)
  }
  return results
}

// ---------------------------------------------------------------------------
// Direct rows: pure scalar/vector semantics freeze, computed with the REAL
// runtime stdlib primitives captured above (not reimplemented). Covers
// tanh(vec3) and mod(vecN,float) with negative operands, +/-0.0, and
// values near float32 representable extremes -- exactly the inputs a
// naive C++ port (unsaturated compression / fmod-based mod) gets wrong,
// AND (per the proof above) the ONLY surface on which the mod sites'
// naive-fmod hazard is actually observable at all.
// ---------------------------------------------------------------------------
const F32_MAX = 3.4028234663852886e38
const F32_MIN_DENORMAL = 1.401298464324817e-45

function tanhRow(vec3In) {
  const input = new Float32Array(vec3In.map(f))
  const result = stdlib.tanh(input)
  return {
    input: Array.from(input), input_bits: Array.from(input).map(f32Bits),
    result: Array.from(result), result_bits: Array.from(result).map(f32Bits),
  }
}
const DIRECT_TANH_ROWS_INPUTS = [
  [0, 0, 0],
  [-0, 0, 0],
  [1, -1, 0.5],
  [-1, 1, -0.5],
  [F32_MAX, -F32_MAX, 0],
  [-F32_MAX, F32_MAX, F32_MAX],
  [F32_MIN_DENORMAL, -F32_MIN_DENORMAL, 0],
  [20, -20, 0.0001],
  [3.14159, -3.14159, 2.71828],
  [1e-10, -1e-10, 0],
]
function buildDirectTanhRows() {
  const rows = DIRECT_TANH_ROWS_INPUTS.map(tanhRow)
  if (rows[0].input_bits[0] === rows[1].input_bits[0]) throw new Error('+0.0/-0.0 tanh input rows did not produce distinct f32 bit patterns')
  return rows
}

function modRow(xVec, y) {
  const x = new Float32Array(xVec.map(f))
  const yF = f(y)
  const real = stdlib.mod(x, yF)
  const naiveOut = new Float32Array(x.length)
  for (let i = 0; i < x.length; i += 1) naiveOut[i] = f(x[i] % yF)
  const diverges = Array.from(real).some((v, i) => f32Bits(v) !== f32Bits(naiveOut[i]))
  return {
    x: Array.from(x), x_bits: Array.from(x).map(f32Bits), y: yF, y_bits: f32Bits(yF),
    real_glsl_mod_result: Array.from(real), real_glsl_mod_result_bits: Array.from(real).map(f32Bits),
    naive_fmod_result: Array.from(naiveOut), naive_fmod_result_bits: Array.from(naiveOut).map(f32Bits),
    diverges_from_naive_fmod: diverges,
  }
}
// y = 289.0 on every row: the one literal divisor used at both reachable
// mod sites (permute's `mod(..., 289.0)` and simplex3D's `mod(i, 289.0)`).
// Rows deliberately include non-integer x -- a value no legitimate caller
// in this program ever produces at either mod site (both are always exact
// integers there, per the proof above) but which the ported function's own
// signature permits and which is exactly where the quadratic-dominance /
// period-289 invariants that hide the bug from full-render no longer apply.
const DIRECT_MOD_ROWS_INPUTS = [
  [[0, 0, 0, 0], 289],
  [[-0, 0, 0, 0], 289],
  [[289, -289, 578, -578], 289],
  [[-1, -0.5, -288.999999, -289.000001], 289],
  [[1, 0.5, 288.999999, 289.000001], 289],
  [[-59500, 59500, -1, 1], 289],
  [[F32_MAX, -F32_MAX, F32_MIN_DENORMAL, -F32_MIN_DENORMAL], 289],
  [[-100000000, 100000000, -0.1271, 0.1271], 289],
]
function buildDirectModRows() {
  const rows = DIRECT_MOD_ROWS_INPUTS.map(([xVec, y]) => modRow(xVec, y))
  // Investigated and confirmed (not assumed): unlike floatBitsToUint's raw
  // bit reinterpretation (which Task31-Caustic found DOES distinguish +0/-0),
  // this arithmetic mod formula (x - y*floor(x/y)) collapses -0.0 to
  // signless +0.0 for a positive divisor: floor(-0/289) is -0, 289*(-0) is
  // -0, and IEEE754 (-0) - (-0) = +0. Both +0.0 and -0.0 inputs are
  // therefore machine-asserted here to produce the IDENTICAL +0.0 bit
  // pattern (0x00000000) -- freezing that collapse is itself the useful
  // fact for native test authors, not a divergence to require.
  if (rows[0].real_glsl_mod_result_bits[0] !== rows[1].real_glsl_mod_result_bits[0]) throw new Error('+0.0/-0.0 mod input rows unexpectedly produced DIFFERENT f32 bit patterns -- the documented arithmetic-mod zero-collapse no longer holds, investigate')
  if (rows[0].real_glsl_mod_result_bits[0] !== '0x00000000') throw new Error('mod(0.0, 289.0) did not produce the expected +0.0 bit pattern')
  const negativeRows = rows.filter(r => r.x.some(v => v < 0))
  if (negativeRows.length === 0) throw new Error('no direct mod row exercises a negative operand')
  const divergentNegativeRows = negativeRows.filter(r => r.diverges_from_naive_fmod)
  if (divergentNegativeRows.length === 0) throw new Error('no negative-operand direct mod row diverges from naive fmod -- the sign-of-divisor discriminator is not actually exercised')
  return rows
}

// ---------------------------------------------------------------------------
// Assembly
// ---------------------------------------------------------------------------
function build() {
  const eligibleRenderCases = buildEligibleRenderRecords()
  const ineligibleRenderCases = buildIneligibleRenderRecords()
  const publicFactoryMutations = buildPublicFactoryMutations()
  const reachabilityProofMutations = buildReachabilityProofMutations()
  const directTanhRows = buildDirectTanhRows()
  const directModRows = buildDirectModRows()

  return {
    schema: 'noisemaker-for-cpp.future-precompute.task31.curl-tanh-mod-closure-oracles.v1',
    corpus_revision: revision,
    provenance: { ...provenance, node: process.version, public_identity: true, adapter_absent: true },
    program: {
      key, defines: { ...AUTHORIZED_DEFINES }, profile_candidate: 'curl-tanh-vec3-mod-vecN-float-v1',
      source_raw_bytes: fs.statSync(sourcePath).size, source_sha256: provenance.source_sha256,
      closure_sites: {
        tanh_vec3_main: { ast_id: 18, corpus_location: '196:12', reachable_from_main: true, full_render_discriminates_naive_mutation: true, js_site: 'main() cpu_vector_assignment_0 (3 scalar tanh() calls forming one vec3 node)' },
        mod_vec4_permute: { ast_id: 20, corpus_location: '35:12', reachable_from_main: true, full_render_discriminates_naive_mutation: false, structural_invariant: 'quadratic-dominance (34x^2+10x >= 0 for all integer x)', js_site: 'permute_vec4()' },
        mod_vec3_simplex3D: { ast_id: 21, corpus_location: '65:9', reachable_from_main: true, full_render_discriminates_naive_mutation: false, structural_invariant: 'period-289-absorption (downstream permute(x) periodic mod 289 for integer x)', js_site: 'simplex3D() `mod(i, 289).reduce(...)`' },
        mod_vec3_permute_dead: { ast_id: 19, corpus_location: '32:12', reachable_from_main: false, full_render_discriminates_naive_mutation: false, structural_invariant: 'n/a -- unreachable, function never called', js_site: 'permute() (vec3 overload) -- never called; simplex3D only calls permute_vec4()' },
      },
      corpus_line_offset_note: 'corpus id:line:col numbers are offset by exactly -10 lines from this raw curl.glsl (all four sites) due to preprocessor stripping of the header comment/#ifndef guard block (lines 1-23 raw vs. 13 effective) before AST parsing; verified by direct anchor match against the raw source and the pinned public factory text.',
    },
    fixture: { full_render: 'no input texture (curl has no sampler uniforms); uniforms + defines only', fragment_origin: 'bottom-left runPass coordinates' },
    eligible_render_cases: eligibleRenderCases,
    ineligible_render_cases: ineligibleRenderCases,
    public_factory_mutations: publicFactoryMutations,
    reachability_proof_mutations: reachabilityProofMutations,
    direct_tanh_rows: directTanhRows,
    direct_mod_rows: directModRows,
    eligibility_summary: {
      total_cases: eligibleRenderCases.length + ineligibleRenderCases.length,
      eligible_cases: eligibleRenderCases.length,
      ineligible_cases: ineligibleRenderCases.length,
    },
    negative_closure: {
      any_other_define_map: 'reject',
      generic_tanh_or_mod_capability: 'forbidden',
      any_mod_or_tanh_site_outside_the_four_authenticated_nodes: 'reject',
      dead_permute_vec3_overload_treated_as_reachable: 'forbidden -- must be reported as expected-dead, not hidden',
      naive_fmod_zero_divergence_at_reachable_mod_sites_treated_as_disproof_of_reachability: 'forbidden -- proven structural invariant, not a coverage gap; see module header',
    },
    risks_and_rejected_designs: [
      {
        id: 'brief-full-render-discrimination-expectation-corrected',
        severity: 'flag-for-operator-signoff',
        description: 'The design brief expected all 3 reachable sites to discriminate via full-render mutation, unlike the one dead site. Empirically (40-trial randomized stress sweep, seed in [-1e6,1e6]) and algebraically (see module header), the two reachable mod(vecN,float) sites are structurally IMMUNE to a naive-fmod full-render mutation -- for two distinct, independently-verified reasons (quadratic dominance at permute_vec4, period-289 absorption at simplex3D). Both sites are proven live via a supplementary wrong-divisor mutation (40/40 divergent). Direct component-level invocation of the real runtime mod() (direct_mod_rows) is therefore the authoritative surface for this hazard, not full-render diffing.',
      },
    ],
  }
}

function report(d) {
  const lines = [
    '# Task31 Curl tanh(vec3) + mod(vecN,float) closure oracle report', '',
    `Eligible full-render cases: **${d.eligible_render_cases.length}**; ineligible full-render cases: **${d.ineligible_render_cases.length}**; direct tanh rows: **${d.direct_tanh_rows.length}**; direct mod rows: **${d.direct_mod_rows.length}**.`,
    '', `Authorized define map: \`${JSON.stringify(d.program.defines)}\`.`, '',
    '## Critical correction to the design brief', '',
    'The brief expected all three *reachable* sites to discriminate via full-render mutation, unlike the one genuinely dead site. Investigation (mandated by this task\'s instructions whenever a reachable site shows 0/N) found that the two `mod(vecN,float)` sites are **structurally immune** to a naive-fmod full-render mutation, for two distinct, independently-proven algebraic reasons -- NOT a coverage gap. See `program.closure_sites` and `risks_and_rejected_designs` in the JSON, and the module header in `curl_oracle_generator.mjs`, for the full proof. Both sites are confirmed genuinely live (executed on every pixel, output reaches the image) via a supplementary "wrong-divisor" mutation that DOES discriminate (40/40 in an ad-hoc randomized sweep; captured formally below as `reachability_proof_mutations`).',
    '', '## Closure sites', '',
    '| Site | AST id | Corpus loc | Reachable | Naive-fmod discriminates via full render |', '| --- | --- | --- | --- | --- |',
  ]
  for (const [name, s] of Object.entries(d.program.closure_sites)) lines.push(`| ${name} | ${s.ast_id} | ${s.corpus_location} | ${s.reachable_from_main} | ${s.full_render_discriminates_naive_mutation} |`)
  lines.push('', d.program.corpus_line_offset_note, '')
  lines.push('## Eligible full-render cases (authorized defines only)', '', '| Case | Size | F32 SHA-256 | RGBA8 SHA-256 |', '| --- | --- | --- | --- |')
  for (const c of d.eligible_render_cases) lines.push(`| ${c.name} | ${c.dimensions.width}x${c.dimensions.height} | \`${c.output.f32_sha256}\` | \`${c.output.rgba8_sha256}\` |`)
  lines.push('', '## Ineligible full-render cases (define-eligibility risk demonstration)', '', '| Case | Defines | F32 SHA-256 |', '| --- | --- | --- |')
  for (const c of d.ineligible_render_cases) lines.push(`| ${c.name} | ${JSON.stringify(c.defines)} | \`${c.output.f32_sha256}\` |`)
  lines.push('', '## Public-factory mutations (the four brief-specified mutations)', '', '| Mutation | Site | Reachable | Expected | Eligible divergent | Ineligible-diag divergent | Result |', '| --- | --- | --- | --- | ---: | ---: | --- |')
  for (const m of d.public_factory_mutations) {
    const eligN = m.eligible_case_results.filter(c => c.diverges).length
    const ineligN = m.ineligible_diagnostic_case_results.filter(c => c.diverges).length
    lines.push(`| ${m.id} | ${m.site} | ${m.reachable} | ${m.expected} | ${eligN}/${m.eligible_case_results.length} | ${ineligN}/${m.ineligible_diagnostic_case_results.length} | matches expectation (machine-asserted at build time) |`)
  }
  lines.push('', 'Expectation legend: `nonzero` = must discriminate (genuine surprise if 0/N). `zero-structural-invariant` = reachable, executed on every pixel, but PROVABLY immune to this specific rounding-rule mutation (see proof in module header / `program.closure_sites`); a nonzero result here would be the surprise. `zero-dead-code` = never called at all, at any define map; 0/N for an entirely different reason than the structural-invariant sites.', '')
  lines.push('## Reachability-proof mutations (supplementary, not the four primary mutations)', '', '| Mutation | Site | Eligible divergent | Purpose |', '| --- | --- | ---: | --- |')
  for (const m of d.reachability_proof_mutations) lines.push(`| ${m.id} | ${m.site} | ${m.eligible_case_results.filter(c => c.diverges).length}/${m.eligible_case_results.length} | ${m.purpose} |`)
  lines.push('', 'These wrong-divisor (288 instead of 289) mutations break both structural invariants and are machine-asserted to diverge on every eligible case -- proof the two mod sites above are genuinely live and their output reaches the rendered image; the naive-fmod 0/N above is specific to that one rounding-rule difference, not to the sites being inert.', '')
  lines.push('## Direct tanh(vec3) rows (real runtime `stdlib.tanh`, not reimplemented)', '', '| Input | Input bits | Result | Result bits |', '| --- | --- | --- | --- |')
  for (const r of d.direct_tanh_rows) lines.push(`| ${JSON.stringify(r.input)} | ${r.input_bits.join(', ')} | ${JSON.stringify(r.result)} | ${r.result_bits.join(', ')} |`)
  lines.push('', '## Direct mod(vecN, 289.0) rows (real runtime `stdlib.mod` vs. naive JS `%` fmod stand-in) -- AUTHORITATIVE closure-parity surface for the naive-fmod hazard', '',
    'Note: `JSON.stringify(-0)` renders as `0` with the sign lost, so the `x bits` / `naive bits` columns (not the plain-value columns) are what actually distinguish +0.0 from -0.0 rows below.', '',
    '| x | x bits | GLSL mod result | Naive fmod result | Naive bits | Diverges |', '| --- | --- | --- | --- | --- | --- |')
  for (const r of d.direct_mod_rows) lines.push(`| ${JSON.stringify(r.x)} | ${r.x_bits.join(', ')} | ${JSON.stringify(r.real_glsl_mod_result)} | ${JSON.stringify(r.naive_fmod_result)} | ${r.naive_fmod_result_bits.join(', ')} | ${r.diverges_from_naive_fmod} |`)
  lines.push('', 'Every row with at least one negative lane is machine-asserted (at build time) to include at least one row where GLSL `mod` and naive `fmod`/`%` diverge -- this is the exact bug shape a C++ port using `std::fmod` instead of implementing `x - y*floor(x/y)` would exhibit. Because full-render cannot observe this hazard at either reachable mod site (see above), THESE direct rows -- not the full-render mutations -- are what a native test suite must bind against to catch a naive-fmod regression. The `[-0,0,0,0]` row additionally freezes a distinct hazard: GLSL\'s arithmetic mod formula collapses -0.0 to signless +0.0 (0x00000000), while naive JS `%` PRESERVES the -0.0 sign bit (0x80000000) -- so even the "does mod(-0, y) equal mod(0, y))" question has a naive-fmod-vs-GLSL-mod answer that differs at the bit level.', '')
  lines.push('## Risks and rejected designs', '')
  for (const r of d.risks_and_rejected_designs) lines.push(`- **${r.id}** (${r.severity}): ${r.description}`, '')
  return lines.join('\n')
}

const data = build()
const json = `${JSON.stringify(data, null, 2)}\n`
const md = `${report(data)}\n`

if (process.argv.includes('--check')) {
  if (!fs.existsSync(outPath) || fs.readFileSync(outPath, 'utf8') !== json) throw new Error('curl oracle JSON drift')
  if (!fs.existsSync(reportPath) || fs.readFileSync(reportPath, 'utf8') !== md) throw new Error('curl oracle report drift')
  console.log(`curl oracle fixture ok (${data.eligible_render_cases.length} eligible + ${data.ineligible_render_cases.length} ineligible render cases, ${data.public_factory_mutations.length} mutations, ${data.reachability_proof_mutations.length} reachability-proof mutations, ${data.direct_tanh_rows.length} tanh rows, ${data.direct_mod_rows.length} mod rows)`)
} else {
  fs.writeFileSync(outPath, json)
  fs.writeFileSync(reportPath, md)
  console.log(outPath)
}
