+            color = shadeVoxel(p, rd, hit.normal, hit.voxel);
+            normal = hit.normal;
+            depth = hit.dist / MAX_DIST;
+        } else {
+            color = bgColor;
+            alpha = bgAlpha;
+        }
+    } else {
+        // Smooth mode - analytic isosurface raymarching
+        IsoHit hit = isosurfaceTrace(ro, rd);
+        if (hit.hit) {
+            color = shade(hit.pos, rd);
+            normal = calcNormal(hit.pos);
+            depth = hit.dist / MAX_DIST;
+        } else {
+            color = bgColor;
+            alpha = bgAlpha;
+        }
+    }
