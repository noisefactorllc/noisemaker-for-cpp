diff --git a/tools/glslcpp/corpus/0ed489ec46842bffba33ee2ec65a218b6dda51f5/sources/render/pointsBillboardRender/diffuse.glsl b/tools/glslcpp/corpus/0ed489ec46842bffba33ee2ec65a218b6dda51f5/sources/render/pointsBillboardRender/diffuse.glsl
