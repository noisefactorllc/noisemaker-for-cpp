+        if (tMaxVec.x < tMaxVec.y) {
+            if (tMaxVec.x < tMaxVec.z) {
+                tStart = tMaxVec.x;
+                tMaxVec.x += tDelta.x;
+                voxel.x += step.x;
+                lastNormal = vec3(-float(step.x), 0.0, 0.0);
+            } else {
+                tStart = tMaxVec.z;
+                tMaxVec.z += tDelta.z;
