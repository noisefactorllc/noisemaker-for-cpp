#!/usr/bin/env bash
# Local entrypoint for the repository's own test lanes, mirroring the CI
# push gate: build the native test binary, run the CTest suite, then the
# Python push-gate subset. The Python lane runs under the same uv-pinned
# interpreter CI uses (the tests need Python 3.13).
set -euo pipefail
cd "$(dirname "$0")/.."

# Focused lane: the supervisor may pass changed paths in NM_CHANGED_FILES,
# one per line. When it is set, run only the tests that exercise those
# paths; with the variable unset, the full suite below runs exactly as
# before and exact-source CI still runs everything.
if [ "${NM_CHANGED_FILES:-}" != "" ]; then
  selected="$(mktemp)"
  native_needed=0
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
      src/*|*.cpp|*.cc|*.h|*.hpp|CMakeLists.txt|cmake/*)
        native_needed=1 ;;
    esac
    case "$path" in
      tests/test_*.py)
        # A deleted test file selects nothing; the module no longer exists.
        [ -f "$path" ] && echo "$path" >> "$selected" ;;
      *)
        stem="$(basename "$path")"; stem="${stem%.*}"
        if [ -n "$stem" ]; then
          grep -l -F -- "$stem" tests/test_*.py >> "$selected" || true
        fi ;;
    esac
  done <<< "$NM_CHANGED_FILES"
  if [ "$native_needed" = 1 ]; then
    if [ "${NOISEMAKER_TEST_SKIP_BUILD:-}" = "" ] || [ ! -x build/noisemaker-cpu-tests ]; then
      cmake -S . -B build -DCMAKE_BUILD_TYPE=Release >&2
      cmake --build build -j "$(nproc)" --target noisemaker-cpu-tests >&2
    fi
    ctest --test-dir build --output-on-failure "$@"
  else
    echo "focused lane: native suite skipped, no native sources changed" >&2
  fi
  lane_status=0
  while IFS= read -r test_file; do
    module="tests.$(basename "$test_file" .py)"
    echo "focused lane: $module" >&2
    uv run --no-project --python 3.13.13 --with pytest env NOISEMAKER_PUSH_GATE=1 \
      python -m unittest "$module" -q || rc=$?
    # unittest exits 5 when a module collects no tests, which is not a
    # failure; every other nonzero exit is.
    if [ "${rc:-0}" != 0 ] && [ "${rc:-0}" != 5 ]; then
      lane_status="$rc"
    fi
    rc=0
  done < <(sort -u "$selected")
  rm -f "$selected"
  exit "$lane_status"
fi

if [ "${NOISEMAKER_TEST_SKIP_BUILD:-}" = "" ] || [ ! -x build/noisemaker-cpu-tests ]; then
  cmake -S . -B build -DCMAKE_BUILD_TYPE=Release >&2
  cmake --build build -j "$(nproc)" --target noisemaker-cpu-tests >&2
fi

ctest --test-dir build --output-on-failure "$@"
# pytest is a LIBRARY dependency here, not the runner: five oracle modules
# import it for `pytest.skip`/`pytest.raises` (ci.yml installs it for the
# same reason), so unittest discovery cannot import them without it.
uv run --no-project --python 3.13.13 --with pytest env NOISEMAKER_PUSH_GATE=1 \
  python -m unittest discover -s tests -p 'test_*.py' -q